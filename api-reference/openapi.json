            "type": "string"
          },
          "deactivation_threshold_amount": {
            "type": "number"
          },
          "startdate": {
            "type": "string",
            "format": "date-time"
          },
          "enddate": {
            "type": "string",
            "format": "date-time"
          },
          "is_end_date_fixed": {
            "type": "boolean"
          },
          "autorecurring_payment": {
            "type": "boolean"
          },
          "membership_privacy": {
            "type": "boolean"
          }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "chapter_id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
