          },
          "enddate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "is_end_date_fixed": {
            "type": "boolean"
          },
          "autorecurring_payment": {
            "type": "boolean"
          },
          "membership_privacy": {
            "type": "boolean"
          },
          "createddate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "lastmodifieddate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "MembershipTypeUpdate": {
        "type": "object",
