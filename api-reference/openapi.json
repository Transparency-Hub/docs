{
  "openapi": "3.0.3",
  "info": {
    "title": "Transparency Hub Public API",
    "version": "1.0.0",
    "description": "Key-authenticated REST API for association and chapter integrations."
  },
  "servers": [
    {
      "url": "https://api.transparencyhubnetwork.ai/api"
    },
    {
      "url": "https://testapp.transparencyhubnetwork.ai/api",
      "description": "Test"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    },
    {
      "BearerAuth": []
    }
  ],
  "x-scopes": {
    "members:read": "Read members",
    "members:write": "Create and update members",
    "membership_types:read": "Read membership types",
    "membership_types:write": "Update membership types",
    "events:read": "Read events",
    "events:write": "Create and update events"
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "chapterId": {
        "name": "chapter_id",
        "in": "query",
        "schema": {
          "type": "integer"
        },
        "description": "Required for association-wide keys; must match the key's chapter for chapter-bound keys."
      },
      "offset": {
        "name": "offset",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "status",
          "code",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        }
      },
      "Member": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "firstname": {
            "type": "string"
          },
          "lastname": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "nullable": true
          },
          "profilepic": {
            "type": "string",
            "nullable": true
          },
          "chapter_id": {
            "type": "integer"
          },
          "role_id": {
            "type": "integer",
            "nullable": true
          },
          "membership_type_id": {
            "type": "integer",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ]
          },
          "is_new_user": {
            "type": "boolean"
          },
          "createddate": {
            "type": "string",
            "format": "date-time"
          },
          "lastmodifieddate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "MemberCreate": {
        "type": "object",
        "required": [
          "firstname",
          "lastname",
          "email"
