          },
          "venue": {
            "type": "string",
            "nullable": true
          },
          "meeting_link": {
            "type": "string",
            "nullable": true
          },
          "document_link": {
            "type": "string",
            "nullable": true
          },
          "event_image": {
            "type": "string",
            "nullable": true
          },
          "start_date_time": {
            "type": "string",
